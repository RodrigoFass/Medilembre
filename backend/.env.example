FLASK_ENV=development
# Em FLASK_ENV=production o app não sobe se as chaves abaixo não forem trocadas
# (mínimo 32 caracteres). Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-forte-minimo-32-chars
JWT_SECRET_KEY=troque-por-outra-chave-secreta-minimo-32-chars
DATABASE_URL=sqlite:///medilembre.db
# Origens do frontend liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu@email.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_DEFAULT_SENDER=seu@email.com
